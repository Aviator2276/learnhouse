# LearnHouse + Authentik. Copy to .env and replace every CHANGE_ME.
# Generate secrets with:  openssl rand -base64 32
# Never commit the real .env (it is gitignored).

# --- Where it runs ------------------------------------------------------------
# Public hostname users type (behind your TLS reverse proxy), without https://.
LEARNHOUSE_DOMAIN=learn.example.com
HTTP_PORT=8080
APPDATA=/mnt/user/appdata/learnhouse

NEXT_PUBLIC_LEARNHOUSE_API_URL=https://learn.example.com/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://learn.example.com/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=learn.example.com
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=example.com
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
# Must equal LEARNHOUSE_INITIAL_ORG_SLUG below. The org is created ONCE, on the
# very first start; changing either value later does not rename it.
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True
NEXT_PUBLIC_COLLAB_URL=wss://learn.example.com/collab
NEXTAUTH_URL=https://learn.example.com
LEARNHOUSE_COOKIE_DOMAIN=.example.com
LEARNHOUSE_PORT=9000

# --- Secrets (all different, all random) -------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
LEARNHOUSE_AUTH_JWT_SECRET_KEY=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
COLLAB_INTERNAL_KEY=CHANGE_ME

# --- First start only: initial admin and organization ------------------------
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@example.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=CHANGE_ME
LEARNHOUSE_INITIAL_ORG_NAME=My Organization
LEARNHOUSE_INITIAL_ORG_SLUG=default   # same as NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG

LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_LOGFIRE_ENABLED=False
LEARNHOUSE_IS_AI_ENABLED=False
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# --- Authentik (see docs/authentik/README.md) --------------------------------
LEARNHOUSE_AUTHENTIK_ENABLED=true
# The provider's "OpenID Configuration Issuer", trailing slash included.
LEARNHOUSE_AUTHENTIK_ISSUER=https://auth.example.com/application/o/learnhouse/
LEARNHOUSE_AUTHENTIK_CLIENT_ID=CHANGE_ME
LEARNHOUSE_AUTHENTIK_CLIENT_SECRET=CHANGE_ME
# Or, instead of the line above, a mounted file:
# LEARNHOUSE_AUTHENTIK_CLIENT_SECRET_FILE=/run/secrets/authentik_client_secret
# Must match the Redirect URI registered in Authentik exactly.
LEARNHOUSE_AUTHENTIK_REDIRECT_URI=https://learn.example.com/auth/callback/authentik
# LEARNHOUSE_AUTHENTIK_POST_LOGOUT_REDIRECT_URI=https://learn.example.com/
# LEARNHOUSE_AUTHENTIK_DISPLAY_NAME=Authentik
# LEARNHOUSE_AUTHENTIK_SCOPES=openid email profile
# Only members of these Authentik groups may sign in (comma separated):
# LEARNHOUSE_AUTHENTIK_ALLOWED_GROUPS=learnhouse-users
# Authentik group -> LearnHouse org role (admin|maintainer|instructor|user):
# LEARNHOUSE_AUTHENTIK_ROLE_MAPPING=learnhouse-admins=admin,learnhouse-teachers=instructor
# LEARNHOUSE_AUTHENTIK_ROLE_SYNC=true
# LEARNHOUSE_AUTHENTIK_AUTO_PROVISION=true
# LEARNHOUSE_AUTHENTIK_LINK_EXISTING_BY_EMAIL=true
# LEARNHOUSE_AUTHENTIK_BYPASS_INVITE=false
# Private CA for an internally-signed Authentik certificate (mount the file):
# LEARNHOUSE_AUTHENTIK_CA_BUNDLE=/run/secrets/authentik-ca.pem

# --- Live classes (plugNmeet) -------------------------------------------------------
# See docs/plugnmeet/README.md. Leave LEARNHOUSE_PLUGNMEET_ENABLED unset to hide
# live classes entirely.
# LEARNHOUSE_PLUGNMEET_ENABLED=true
# How the API reaches plugNmeet. Plain http is accepted only for LAN addresses
# (private IPs, container names); anything else must be https.
# LEARNHOUSE_PLUGNMEET_SERVER_URL=http://192.168.1.20:8080
# What browsers open (always https):
# LEARNHOUSE_PLUGNMEET_CLIENT_URL=https://meet.example.com
# From plugNmeet's .env: PLUG_N_MEET_API_KEY and PLUG_N_MEET_SECRET.
# LEARNHOUSE_PLUGNMEET_API_KEY=plugnmeet
# LEARNHOUSE_PLUGNMEET_API_SECRET=CHANGE_ME
# Or keep the secret in a file:
# LEARNHOUSE_PLUGNMEET_API_SECRET_FILE=/run/secrets/plugnmeet_api_secret
# Where "Leave" returns to; defaults to https://${LEARNHOUSE_DOMAIN}.
# LEARNHOUSE_PLUGNMEET_PUBLIC_URL=https://learn.example.com
# Attendance: also set webhook_conf in plugNmeet's config.yaml (see the docs).
# LEARNHOUSE_PLUGNMEET_WEBHOOK_ENABLED=true
# One org-wide "Meeting room" that admins/maintainers open on demand:
# LEARNHOUSE_PLUGNMEET_QUICK_ROOM=true
# Hosts may open a class's room this many minutes early / late:
# LEARNHOUSE_PLUGNMEET_START_EARLY_MINUTES=60
# LEARNHOUSE_PLUGNMEET_END_GRACE_MINUTES=60
